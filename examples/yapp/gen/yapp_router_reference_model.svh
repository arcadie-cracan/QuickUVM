function pkt_seq_item yapp_router_predictor::predict(pkt_seq_item t);
  // Declare static state variables needed between calls
  // static logic [W-1:0] ex_prev;

  pkt_seq_item extr = pkt_seq_item::type_id::create("extr");

  `uvm_info("CALC #1", t.convert2string(), UVM_FULL)

  // Copy all sampled inputs & outputs
  extr.copy(t);

  // pragma quickuvm custom prediction_logic begin
  // Route by the packet's destination address: a valid packet appears next cycle on
  // out<addr>; DROP (3) produces no output. out*_data is the registered payload on
  // every channel (the RTL latches in_data unconditionally), gated by out*_valid.
  extr.out0_valid = (t.in_addr == P0);
  extr.out1_valid = (t.in_addr == P1);
  extr.out2_valid = (t.in_addr == P2);
  extr.out0_data  = t.in_data;
  extr.out1_data  = t.in_data;
  extr.out2_data  = t.in_data;
    // pragma quickuvm custom prediction_logic end

  `uvm_info("CALC #2", extr.convert2string(), UVM_FULL)
  return(extr);
endfunction
