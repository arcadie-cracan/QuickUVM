class pkt_monitor extends uvm_monitor;
  `uvm_component_utils(pkt_monitor)

  virtual pkt_if vif;

  uvm_analysis_port #(pkt_seq_item) ap;

  // pragma quickuvm custom class_item_additional begin
  // pragma quickuvm custom class_item_additional end

  function new (string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    ap = new("ap", this);
  endfunction

  task run_phase(uvm_phase phase);
    pkt_seq_item tr;
    // Reset is driven externally: do not emit transactions until it deasserts, then
    // resync to the clock grid (sample_dut() assumes it starts at a posedge clk).
    wait (vif.rst_n === 1'b1);
    @vif.cb1;
    // Portability: prime one clock before the first pairing, so the DUT has produced a
    // valid first output. A simulator that schedules the driver's first drive AFTER the
    // monitor's first sample (Questa, VCS) otherwise pairs the reset output with the
    // first stimulus -> one spurious startup mismatch. Benign where the scheduler
    // already aligns them (Cadence). Skipped for responder/request-fifo monitors, whose
    // sampling publishes requests and must not be delayed.
    @vif.cb1;
    forever begin
      sample_dut(tr);
      // Publish only valid/qualified transactions (emit_when: in_valid).
      if (tr.in_valid) ap.write(tr);
    end
  endtask

  task sample_dut (output pkt_seq_item tr);
    pkt_seq_item t;
    t = pkt_seq_item::type_id::create("t");
    //---------------------------------------------
    // Assumption: sample_dut() is already sync-ed to posedge clk
    // Sample DUT inputs now (on posedge clk)
    //---------------------------------------------
    t.in_valid = vif.in_valid;
    void'($cast(t.in_addr, vif.in_addr));
    t.in_data = vif.in_data;

    @vif.cb1;
    //---------------------------------------------
    // Re-test async reset and re-assign if asserted
    //---------------------------------------------
    //---------------------------------------------
    // Sample DUT outputs #1step before posedge clk
    // Uses clocking block timing
    //---------------------------------------------
    t.out0_valid = vif.cb1.out0_valid;
    t.out0_data = vif.cb1.out0_data;
    t.out1_valid = vif.cb1.out1_valid;
    t.out1_data = vif.cb1.out1_data;
    t.out2_valid = vif.cb1.out2_valid;
    t.out2_data = vif.cb1.out2_data;

    // pragma quickuvm custom sample_dut_additional begin
    // pragma quickuvm custom sample_dut_additional end

    tr = t;
    `uvm_info("sample_dut", tr.convert2string(), UVM_FULL)
  endtask

endclass
