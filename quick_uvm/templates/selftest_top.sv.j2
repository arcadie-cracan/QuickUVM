// F2' VIP SELF-TEST top — there is NO DUT. The VIP's agent(s) are exercised against a
// loopback so the reusable VIP can be validated stand-alone (the shape of a VIP's own
// dv/tb). Fill the loopback seam with what the VIP's counterpart would produce; the
// scoreboard checks the agent's sampled outputs against its predicted response.
//----------------------------------------------------------------------

`include "uvm_macros.svh"
module {{ top_name }};
  import uvm_pkg::*;
  import {{ dut.name }}_test_pkg::*;

  logic clk;
{% if dut.external_reset %}
  logic {{ dut.reset }};
{% endif %}
  clkgen ck (clk);
{% if dut.external_reset %}

  // Reset generator. A VIP built with a top-driven reset has interfaces that TAKE
  // the reset, and its driver and monitor wait for it — so the self-test top must
  // generate it exactly as a bench top does (it used to leave the input unconnected,
  // and the self-test hung at time 0).
  // pragma quickuvm custom reset_generator begin
  initial begin
    {{ dut.reset }} = 1'b{% if dut.reset_active_low %}0{% else %}1{% endif %};   // assert
    repeat (5) @(posedge clk);
    // NOTE: the driver and monitor block until this deasserts — if you edit this
    // block you MUST drive {{ dut.reset }} to its inactive level or the TB will hang.
    {{ dut.reset }} = 1'b{% if dut.reset_active_low %}1{% else %}0{% endif %};   // deassert
  end
  // pragma quickuvm custom reset_generator end
{% endif %}

  // The VIP interface(s) — instantiated, but wired to a loopback, not a DUT.
{% for agent in agents %}
  {{ agent.interface }}{{ agent.param_args_values }} {{ agent.interface }}_inst ({% if dut.external_reset %}.clk(clk), .{{ dut.reset }}({{ dut.reset }}){% else %}clk{% endif %});
{% endfor %}

  // SELF-TEST LOOPBACK — the stand-in for the absent DUT. Drive each agent's sampled
  // outputs from whatever the VIP's counterpart should produce (the simplest is a direct
  // loopback of the driven inputs). Leaving this empty leaves the outputs undriven (X),
  // which the scoreboard catches — a self-test that tests nothing must not pass silently.
  // No generator emits protocol logic; this is your seam.
  // pragma quickuvm custom selftest_loopback begin
  // pragma quickuvm custom selftest_loopback end

  initial begin
{% for agent in agents %}
    uvm_config_db#(virtual {{ agent.interface }}{{ agent.param_args_values }})::set(null, "*", "{{ agent.interface }}_vif", {{ agent.interface }}_inst);
{% endfor %}
    run_test();
  end
endmodule
